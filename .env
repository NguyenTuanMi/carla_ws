# Copy this file to .env and fill in your values:
#   cp env.example .env

TZ=Asia/Singapore

ROS_DOMAIN_ID=0

CARLA_HOST=127.0.0.1
CARLA_PORT=2000


SCENARIO_ARGS=

# --- Traffic generation ---
# Extra args passed to generate_traffic.py (e.g. -n 50 -w 20)
TRAFFIC_ARGS=

# --- Rosbag topics ---
# Space-separated list of topics to record. Defaults to /clock only.
# Example: BAG_TOPICS=/clock /carla/ego_vehicle/odometry /carla/ego_vehicle/rgb_front/image
BAG_TOPICS=/clock

# --- Docker user mapping ---
# Match these to your host user to avoid file permission issues on mounted volumes.
# Run: echo "USER_UID=$(id -u)" >> .env && echo "USER_GID=$(id -g)" >> .env
USER_UID=1000
USER_GID=1000