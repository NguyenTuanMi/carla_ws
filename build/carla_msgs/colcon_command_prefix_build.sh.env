AMENT_PREFIX_PATH=/opt/ros/humble
BAG_TOPICS=/clock /tf /carla/hero/rgb/image /carla/hero/vehicle_control_cmd /cabin/image_raw
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
COLCON=1
DEBIAN_FRONTEND=noninteractive
DISPLAY=:1
HOME=/home/carlauser
HOSTNAME=carla-ros-container
LC_CTYPE=C.UTF-8
LD_LIBRARY_PATH=/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib
OLDPWD=/home/carlauser/carla_ws
PATH=/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/home/carlauser/carla_ws/build/carla_msgs
PYTHONPATH=/opt/carla_src/PythonAPI/carla:/opt/scenario_runner:/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
RCUTILS_COLORIZED_OUTPUT=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SCENARIO_ARGS=--openscenario /home/carlauser/carla_ws/scenarios/town10_crossing.xosc
SCENARIO_RUNNER_ROOT=/opt/scenario_runner
SHLVL=0
TERM=xterm
TRAFFIC_ARGS=--asynch --number-of-vehicles 70 --number-of-walkers 100
TZ=Asia/Singapore
XAUTHORITY=/home/carlauser/.Xauthority
_=/usr/bin/colcon
